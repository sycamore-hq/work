#!/usr/bin/env python3
"""Sync work.json onto the org GitHub Project as a roadmap.

work.json is the record. The git repository wins every vote: this script
makes the Project and the issues agree with the ledger, never the reverse.

- Status (Todo / In Progress / Done)
- Lane (In progress / Next / Waiting / Held / Done) — swimlanes
- Start date / Target date — sequence bars, not deadlines
- Issue blocked_by edges from ledger blocked_by
- Issue labels: kind, repo:<name>, and one state word (todo / waiting /
  in-progress / blocked / parked; done carries none — the closed issue does)
- Issue open / closed: done closes as completed, anything else reopens
- Roadmap view + Next table

Needs org project write. cursor[bot] does not have it.

    just project-roadmap
    just project-roadmap --dry-run   # planned label / open-closed changes; no writes
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

ROOT = Path(__file__).resolve().parent.parent
LEDGER = ROOT / "work.json"
OWNER = "sycamore-hq"
TITLE = "sycamore-hq work"
REPO = f"{OWNER}/work"

STATUS_MAP = {
    "done": "Done",
    "in_progress": "In Progress",
    "todo": "Todo",
    "blocked": "Todo",
    "parked": "Todo",
}

LANES = ["In progress", "Next", "Waiting", "Held", "Done"]

SPAN_DAYS = 5
STRIDE_DAYS = 7

KIND_LABELS = frozenset({"planned", "outstanding", "hygiene", "parked"})
STATE_LABELS = frozenset({"todo", "waiting", "in-progress", "blocked", "parked"})
LEGACY_STATE_LABELS = frozenset({"in_progress"})
REPO_LABEL_PREFIX = "repo:"

API_HEADERS = [
    "-H",
    "Accept: application/vnd.github+json",
    "-H",
    "X-GitHub-Api-Version: 2026-03-10",
]


def run(args: list[str], *, ok: tuple[int, ...] = (0,), input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(args, text=True, capture_output=True, input=input_text)
    if proc.returncode not in ok:
        sys.stderr.write(proc.stderr)
        raise SystemExit(f"failed ({proc.returncode}): {' '.join(args)}")
    return proc


def gh_json(args: list[str], *, input_text: str | None = None, ok: tuple[int, ...] = (0,)) -> object:
    proc = run(["gh", *args], ok=ok, input_text=input_text)
    if not proc.stdout.strip():
        return None
    return json.loads(proc.stdout)


def gh_api(path: str, *, method: str | None = None, body: object | None = None, ok: tuple[int, ...] = (0,)) -> object:
    args = ["api", *API_HEADERS]
    if method:
        args += ["--method", method]
    args.append(path)
    input_text = None
    if body is not None:
        args += ["--input", "-"]
        input_text = json.dumps(body)
    return gh_json(args, input_text=input_text, ok=ok)


def option_name(opt: dict) -> str:
    name = opt.get("name")
    if isinstance(name, dict):
        return str(name.get("raw") or name.get("html") or "")
    return str(name or "")


def load_ledger() -> dict:
    raw = json.loads(LEDGER.read_text())
    if not isinstance(raw, dict) or not isinstance(raw.get("items"), list):
        raise SystemExit(f"{LEDGER}: expected an object with items")
    return raw


def project_number() -> int:
    listing = gh_api(f"orgs/{OWNER}/projectsV2?per_page=100")
    projects = listing if isinstance(listing, list) else (listing or {}).get("projects") or []
    for project in projects:
        if project.get("title") == TITLE:
            return int(project["number"])
    raise SystemExit(f"project '{TITLE}' not found on {OWNER}; run just project-seed")


def field_list(number: int) -> dict[str, dict]:
    data = gh_api(f"orgs/{OWNER}/projectsV2/{number}/fields")
    rows = data if isinstance(data, list) else (data or {}).get("fields") or []
    fields = {}
    for field in rows:
        if isinstance(field, dict) and field.get("name"):
            fields[field["name"]] = field
    return fields


def ensure_date_fields(number: int, fields: dict[str, dict]) -> None:
    for name in ("Start date", "Target date"):
        if name in fields:
            continue
        created = gh_api(
            f"orgs/{OWNER}/projectsV2/{number}/fields",
            method="POST",
            body={"name": name, "data_type": "date"},
        )
        print(f"created field {name}", file=sys.stderr)
        if isinstance(created, dict):
            fields[name] = created


def ensure_lane_field(number: int, fields: dict[str, dict]) -> None:
    if "Lane" in fields:
        missing = [lane for lane in LANES if lane not in select_options(fields["Lane"])]
        if missing:
            raise SystemExit(
                f"Lane field is missing options {missing}; "
                "add them in the project settings, then rerun"
            )
        return
    created = gh_api(
        f"orgs/{OWNER}/projectsV2/{number}/fields",
        method="POST",
        body={
            "name": "Lane",
            "data_type": "single_select",
            "options": LANES,
        },
    )
    print("created field Lane", file=sys.stderr)
    if isinstance(created, dict):
        fields["Lane"] = created


def select_options(field: dict) -> dict[str, str]:
    out: dict[str, str] = {}
    for opt in field.get("options") or []:
        if isinstance(opt, dict) and opt.get("id"):
            out[option_name(opt)] = str(opt["id"])
    return out


def item_ids_by_issue(number: int) -> dict[int, int]:
    data = gh_api(f"orgs/{OWNER}/projectsV2/{number}/items?per_page=100")
    rows = data if isinstance(data, list) else (data or {}).get("items") or []
    out: dict[int, int] = {}
    for row in rows:
        if not isinstance(row, dict):
            continue
        issue = (row.get("content") or {}).get("number")
        if isinstance(issue, int) and row.get("id") is not None:
            out[issue] = int(row["id"])
    return out


def is_held(item: dict) -> bool:
    """Blocked/parked status or parked kind — Held on the board, no sequence bar."""
    return item.get("status") in {"blocked", "parked"} or item.get("kind") == "parked"


def lane_of(item: dict, done: set[str]) -> str:
    status = item.get("status")
    if status == "in_progress":
        return "In progress"
    if is_held(item):
        return "Held"
    if status == "done":
        return "Done"
    missing = [d for d in (item.get("blocked_by") or []) if d not in done]
    if missing:
        return "Waiting"
    return "Next"


def state_label(item: dict, done: set[str]) -> str | None:
    """One state word per open item. Done items carry none. Pure."""
    status = item.get("status")
    if status == "in_progress":
        return "in-progress"
    if is_held(item):
        return "parked" if item.get("kind") == "parked" else str(status)
    if status == "done":
        return None
    missing = [d for d in (item.get("blocked_by") or []) if d not in done]
    return "waiting" if missing else "todo"


def desired_labels(item: dict, done: set[str]) -> set[str]:
    """Kind + repo:<name> per repo + state word. Pure."""
    labels = {f"{REPO_LABEL_PREFIX}{repo}" for repo in item.get("repos") or []}
    kind = item.get("kind")
    if kind:
        labels.add(str(kind))
    state = state_label(item, done)
    if state:
        labels.add(state)
    return labels


def desired_issue_state(item: dict) -> str:
    """Done closes; every other ledger status keeps the issue open. Pure."""
    return "closed" if item.get("status") == "done" else "open"


def is_managed_label(name: str) -> bool:
    return (
        name in KIND_LABELS
        or name in STATE_LABELS
        or name in LEGACY_STATE_LABELS
        or name.startswith(REPO_LABEL_PREFIX)
    )


def reconcile_labels(current: set[str], desired: set[str]) -> set[str]:
    """Replace every managed label with the desired set; keep the rest. Pure."""
    return {name for name in current if not is_managed_label(name)} | desired


def label_lookup_outcome(returncode: int, stdout: str, stderr: str) -> str:
    """exists | missing | failed. Pure."""
    if returncode == 0:
        return "exists"
    text = (stderr or "") + (stdout or "")
    return "missing" if "404" in text else "failed"


def label_change_line(issue: int, current: set[str], target: set[str]) -> str | None:
    """`#N labels +a -b`, or None when current already matches. Pure."""
    if target == current:
        return None
    added = ", ".join(f"+{n}" for n in sorted(target - current))
    removed = ", ".join(f"-{n}" for n in sorted(current - target))
    return f"#{issue} labels {' '.join(x for x in (added, removed) if x)}"


def issue_state_change_line(issue: int, item: dict, current: str) -> str | None:
    """`#N closed -> open (...)`, or None when current already matches. Pure."""
    target = desired_issue_state(item)
    if target == current:
        return None
    return f"#{issue} {current} -> {target} ({item['id']} is {item.get('status')})"


def depth(item: dict, by_id: dict[str, dict], path: frozenset[str] = frozenset()) -> int:
    """Longest blocked_by chain below item. `path` is the chain being walked, so a
    blocker shared by two branches (a diamond) is not mistaken for a cycle."""
    ident = item["id"]
    if ident in path:
        raise SystemExit(f"cycle at {ident}")
    deps = item.get("blocked_by") or []
    if not deps:
        return 0
    return 1 + max(depth(by_id[dep], by_id, path | {ident}) for dep in deps)


def sequence_dates(
    item: dict, by_id: dict[str, dict], today: _dt.date
) -> tuple[_dt.date, _dt.date] | None:
    if item.get("status") == "done" or is_held(item):
        return None
    start = today + _dt.timedelta(days=STRIDE_DAYS * depth(item, by_id))
    return start, start + _dt.timedelta(days=SPAN_DAYS)


def set_item_fields(number: int, item_id: int, updates: list[dict]) -> None:
    gh_api(
        f"orgs/{OWNER}/projectsV2/{number}/items/{item_id}",
        method="PATCH",
        body={"fields": updates},
    )


class IssueRecord(NamedTuple):
    id: int
    labels: set[str]
    state: str


def issue_record(number: int) -> IssueRecord:
    """Raw id, label names, and open/closed state. Action: one GET."""
    data = gh_api(f"repos/{REPO}/issues/{number}")
    if not isinstance(data, dict) or "id" not in data:
        raise SystemExit(f"issue #{number} unreadable")
    labels = {
        str(row["name"])
        for row in data.get("labels") or []
        if isinstance(row, dict) and row.get("name")
    }
    return IssueRecord(int(data["id"]), labels, str(data.get("state") or "open"))


def sync_issue_state(issue: int, item: dict, current: str, *, dry_run: bool = False) -> None:
    """Close done items, reopen everything else. Action."""
    line = issue_state_change_line(issue, item, current)
    if line is None:
        return
    if not dry_run:
        target = desired_issue_state(item)
        body = {"state": target, "state_reason": "completed" if target == "closed" else "reopened"}
        gh_api(f"repos/{REPO}/issues/{issue}", method="PATCH", body=body)
    print(line, file=sys.stderr)


def ensure_label(name: str, known: set[str]) -> None:
    """Create a repo label if it does not exist. Action."""
    if name in known:
        return
    proc = subprocess.run(
        ["gh", "api", *API_HEADERS, f"repos/{REPO}/labels/{name}"],
        text=True,
        capture_output=True,
    )
    outcome = label_lookup_outcome(proc.returncode, proc.stdout, proc.stderr)
    if outcome == "failed":
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(f"read label {name} failed")
    if outcome == "missing":
        gh_api(
            f"repos/{REPO}/labels",
            method="POST",
            body={"name": name, "color": "ededed"},
        )
        print(f"created label {name}", file=sys.stderr)
    known.add(name)


def set_issue_labels(issue: int, labels: set[str]) -> None:
    gh_api(
        f"repos/{REPO}/issues/{issue}/labels",
        method="PUT",
        body={"labels": sorted(labels)},
    )


def sync_labels(
    issue: int,
    item: dict,
    current: set[str],
    done: set[str],
    known: set[str],
    *,
    dry_run: bool = False,
) -> None:
    """Bring one issue's managed labels in line with the ledger. Action."""
    target = reconcile_labels(current, desired_labels(item, done))
    line = label_change_line(issue, current, target)
    if line is None:
        return
    if not dry_run:
        for name in sorted(target - current):
            ensure_label(name, known)
        set_issue_labels(issue, target)
    print(line, file=sys.stderr)


def list_blocked_by(issue: int) -> set[int]:
    proc = subprocess.run(
        ["gh", "api", *API_HEADERS, f"repos/{REPO}/issues/{issue}/dependencies/blocked_by"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        if "404" in (proc.stderr or "") or "404" in (proc.stdout or ""):
            return set()
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(f"list blocked_by #{issue} failed")
    payload = json.loads(proc.stdout) if proc.stdout.strip() else []
    ids = set()
    if isinstance(payload, list):
        for row in payload:
            if isinstance(row, dict):
                blocker = row.get("blocked_by") or row.get("issue") or row
                if isinstance(blocker, dict) and "id" in blocker:
                    ids.add(int(blocker["id"]))
                elif isinstance(row.get("id"), int):
                    ids.add(int(row["id"]))
    return ids


def add_blocked_by(issue: int, blocker_id: int) -> None:
    proc = subprocess.run(
        [
            "gh",
            "api",
            *API_HEADERS,
            "--method",
            "POST",
            f"repos/{REPO}/issues/{issue}/dependencies/blocked_by",
            "--input",
            "-",
        ],
        text=True,
        capture_output=True,
        input=json.dumps({"issue_id": int(blocker_id)}),
    )
    if proc.returncode == 0:
        return
    text = (proc.stderr or "") + (proc.stdout or "")
    if "already" in text.lower():
        return
    sys.stderr.write(text)
    raise SystemExit(f"blocked_by #{issue} <- {blocker_id} failed")


def seeded_views(number: int) -> dict[str, dict]:
    known = {2: ("Roadmap", "roadmap"), 3: ("Next", "table")}
    found: dict[str, dict] = {}
    for view_number, (name, layout) in known.items():
        proc = subprocess.run(
            [
                "gh",
                "api",
                *API_HEADERS,
                f"orgs/{OWNER}/projectsV2/{number}/views/{view_number}/items?per_page=1",
            ],
            text=True,
            capture_output=True,
        )
        if proc.returncode != 0:
            continue
        found[name] = {
            "name": name,
            "layout": layout,
            "number": view_number,
            "html_url": f"https://github.com/orgs/{OWNER}/projects/{number}/views/{view_number}",
        }
    return found


def existing_views(number: int) -> dict[str, dict]:
    proc = subprocess.run(
        ["gh", "api", *API_HEADERS, f"orgs/{OWNER}/projectsV2/{number}/views"],
        text=True,
        capture_output=True,
    )
    if proc.returncode == 0 and proc.stdout.strip():
        payload = json.loads(proc.stdout)
        rows = payload if isinstance(payload, list) else payload.get("views") or payload.get("items") or []
        return {n["name"]: n for n in rows if isinstance(n, dict) and n.get("name")}
    return seeded_views(number)


def rest_fields(number: int) -> dict[str, int]:
    out = {}
    for name, field in field_list(number).items():
        if field.get("id") is not None:
            out[name] = int(field["id"])
    return out


def ensure_view(number: int, name: str, layout: str, *, filter_q: str | None = None, group_field: int | None = None) -> dict:
    views = existing_views(number)
    if name in views:
        view = views[name]
        if not view.get("html_url") and view.get("number") is not None:
            view["html_url"] = f"https://github.com/orgs/{OWNER}/projects/{number}/views/{view['number']}"
        print(f"reusing view {name} ({view.get('layout')})", file=sys.stderr)
        return view
    body: dict = {"name": name, "layout": layout}
    if filter_q:
        body["filter"] = filter_q
    if group_field is not None:
        body["group_by"] = [group_field]
    created = gh_api(
        f"orgs/{OWNER}/projectsV2/{number}/views",
        method="POST",
        body=body,
    )
    if isinstance(created, dict):
        print(f"created view {name} → {created.get('html_url')}", file=sys.stderr)
        return created
    raise SystemExit(f"create view {name} failed")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print planned label and open/closed changes; write nothing",
    )
    return parser.parse_args(argv)


def preview_issue_writes(items: list[dict], done: set[str]) -> int:
    """Print planned label and open/closed changes. Action: GET only."""
    for item in items:
        issue = item.get("issue")
        if not isinstance(issue, int):
            continue
        record = issue_record(issue)
        sync_labels(issue, item, record.labels, done, set(), dry_run=True)
        sync_issue_state(issue, item, record.state, dry_run=True)
    return 0


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    ledger = load_ledger()
    items = [i for i in ledger["items"] if isinstance(i, dict)]
    by_id = {i["id"]: i for i in items}
    done = {i["id"] for i in items if i.get("status") == "done"}
    if args.dry_run:
        return preview_issue_writes(items, done)
    today = _dt.datetime.now(_dt.timezone.utc).date()

    number = project_number()
    print(f"project #{number}", file=sys.stderr)

    fields = field_list(number)
    ensure_date_fields(number, fields)
    ensure_lane_field(number, fields)
    status_opts = select_options(fields["Status"])
    lane_opts = select_options(fields["Lane"])
    issue_items = item_ids_by_issue(number)

    for item in items:
        issue = item.get("issue")
        if not isinstance(issue, int):
            continue
        item_id = issue_items.get(issue)
        if item_id is None:
            raise SystemExit(f"#{issue} is not on the project; run just project-seed")
        status_value = STATUS_MAP[item["status"]]
        lane = lane_of(item, done)
        updates = [
            {"id": fields["Status"]["id"], "value": status_opts[status_value]},
            {"id": fields["Lane"]["id"], "value": lane_opts[lane]},
        ]
        dates = sequence_dates(item, by_id, today)
        if dates is not None:
            start, target = dates
            updates.append({"id": fields["Start date"]["id"], "value": start.isoformat()})
            updates.append({"id": fields["Target date"]["id"], "value": target.isoformat()})
            print(f"#{issue} {item['id']} {status_value} {lane} {start}→{target}", file=sys.stderr)
        else:
            print(f"#{issue} {item['id']} {status_value} {lane}", file=sys.stderr)
        set_item_fields(number, item_id, updates)

    numeric: dict[str, int] = {}
    known_labels: set[str] = set()
    for item in items:
        issue = item.get("issue")
        if isinstance(issue, int):
            record = issue_record(issue)
            numeric[item["id"]] = record.id
            sync_labels(issue, item, record.labels, done, known_labels)
            sync_issue_state(issue, item, record.state)

    for item in items:
        issue = item.get("issue")
        if not isinstance(issue, int):
            continue
        blockers = item.get("blocked_by") or []
        if not blockers:
            continue
        have = list_blocked_by(issue)
        for dep in blockers:
            blocker_issue = by_id[dep].get("issue")
            blocker_id = numeric.get(dep)
            if not isinstance(blocker_issue, int) or blocker_id is None:
                raise SystemExit(f"{item['id']} waits on {dep} with no issue")
            if blocker_id in have:
                continue
            add_blocked_by(issue, blocker_id)
            print(f"#{issue} blocked by #{blocker_issue} ({dep})", file=sys.stderr)

    rest = rest_fields(number)
    roadmap = ensure_view(
        number,
        "Roadmap",
        "roadmap",
        filter_q="-status:Done",
        group_field=rest.get("Lane"),
    )
    nxt = ensure_view(
        number,
        "Next",
        "table",
        filter_q="Lane:Next",
    )

    print(f"roadmap: {roadmap.get('html_url') or f'https://github.com/orgs/{OWNER}/projects/{number}'}")
    print(f"next: {nxt.get('html_url') or roadmap.get('html_url')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
